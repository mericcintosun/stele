# Stele environment.
#
# Every variable below is optional. With none of them set the decision console
# still runs end to end: WEEX calls return shaped mock fills and the model chain
# falls through to the local claude CLI, then to the offline stub. Nothing in
# the UI is a dead end without keys.

# ---------------------------------------------------------------------------
# WEEX OpenAPI v3
# ---------------------------------------------------------------------------
# Create the keys at weex.com under API Management, then have the AI Wars II
# organizers add your UID and your server's static IP to the allowlist. Until
# that approval lands, uploadAiLog rejects the write and Stele queues it locally.
# Read by lib/weex.ts.
WEEX_API_KEY=
WEEX_API_SECRET=
WEEX_API_PASSPHRASE=

# API host. Leave as is unless WEEX gives you a regional endpoint.
WEEX_API_HOST=https://api-contract.weex.com

# "sim" routes orders through the demo futures endpoints (/capi/v3/sim/...),
# "live" sends real orders with real money. Default is sim. Flip to live only
# after the 11 step API checklist in HANDOFF.md passes on sim.
WEEX_VENUE=sim

# ---------------------------------------------------------------------------
# Model chain (lib/agent.ts)
# ---------------------------------------------------------------------------
# Get a key at console.anthropic.com. This is the submission path: the recorded
# demo must run with this set, because the AI model token allocation is awarded
# on proof of real model usage.
ANTHROPIC_API_KEY=

# Optional model override. Defaults to claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5

# No key? Install the claude CLI (npm i -g @anthropic-ai/claude-code) and
# lib/agent.ts uses it automatically for local development. No variable needed.
